{
  "Material": {
    "prefix": "material",
    "description": "A standard_surface shader and the material that uses it",
    "body": [
      "surfaceshader ${1:surface} = standard_surface(",
      "    base_color = ${2:color3{0.8, 0.8, 0.8\\}},",
      "    specular_roughness = ${3:0.4}",
      ");",
      "material ${4:my_material} = surfacematerial($1);"
    ]
  },
  "Entry function": {
    "prefix": "main",
    "description": "An entry function, compiled with the -f/--func option",
    "body": [
      "inline void ${1:main}()",
      "{",
      "    surfacematerial(",
      "        standard_surface(",
      "            base_color = ${2:color3{1.0, 0.72, 0.315\\}},",
      "            specular_roughness = ${3:0.02},",
      "            metalness = ${4:1.0}",
      "        )",
      "    );",
      "}"
    ]
  },
  "Function": {
    "prefix": "func",
    "description": "A function with doc attributes, compiled to a NodeDef",
    "body": [
      "@doc \"${3:What the function does}\"",
      "@out.doc \"${4:What it returns}\"",
      "${1:float} ${2:name}(${5:float} ${6:in})",
      "{",
      "    return ${0:$6};",
      "}"
    ]
  },
  "Inline function": {
    "prefix": "inline",
    "description": "A function that is inlined at each call",
    "body": [
      "inline ${1:float} ${2:name}(${3:float} ${4:x})",
      "{",
      "    return ${0:$4};",
      "}"
    ]
  },
  "Templated function": {
    "prefix": "template",
    "description": "A function defined once for several types",
    "body": [
      "T ${1:name}<${2:float, vec2, vec3}>(T ${3:x})",
      "{",
      "    return ${0:$3};",
      "}"
    ]
  },
  "Class": {
    "prefix": "class",
    "description": "A class with a constructor and a field",
    "body": [
      "class ${1:Name}",
      "{",
      "    $1(${2:float} ${3:v})",
      "    {",
      "        this.${4:value} = $3;",
      "    }",
      "",
      "    $2 $4;",
      "}"
    ]
  },
  "For loop": {
    "prefix": "for",
    "description": "A loop over a range of integers",
    "body": [
      "for (int ${1:i} from ${2:0} to ${3:9})",
      "{",
      "    $0",
      "}"
    ]
  },
  "If expression": {
    "prefix": "if",
    "description": "An if expression, which evaluates to one of two values",
    "body": [
      "if (${1:condition}) { ${2:value_if_true} } else { ${3:value_if_false} }"
    ]
  },
  "Switch expression": {
    "prefix": "switch",
    "description": "A switch expression, which selects a value by index",
    "body": [
      "switch (${1:index})",
      "{",
      "    ${2:value_0},",
      "    ${3:value_1},",
      "    default: ${4:value_2}",
      "}"
    ]
  },
  "Global": {
    "prefix": "global",
    "description": "A global variable, whose value can be set when compiling",
    "body": [
      "global ${1:float} ${2:name} = ${3:0.0};"
    ]
  }
}
