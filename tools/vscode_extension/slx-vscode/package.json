{
  "name": "slx",
  "displayName": "ShadingLanguageX (SLX)",
  "description": "Language support for ShadingLanguageX (SLX): highlighting, errors as you type, completion, hovers, navigation, snippets, a live MaterialX preview and SLX <-> MaterialX conversion",
  "version": "0.4.0",
  "publisher": "shadinglanguagex",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakethorn/ShadingLanguageX"
  },
  "bugs": {
    "url": "https://github.com/jakethorn/ShadingLanguageX/issues"
  },
  "keywords": [
    "slx",
    "shadinglanguagex",
    "mxsl",
    "materialx",
    "shading language",
    "ai",
    "skill"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:slx"
  ],
  "contributes": {
    "languages": [
      {
        "id": "slx",
        "aliases": [
          "SLX",
          "ShadingLanguageX"
        ],
        "extensions": [
          ".mxsl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "xml",
        "extensions": [
          ".mtlx"
        ]
      }
    ],
    "grammars": [
      {
        "language": "slx",
        "scopeName": "source.slx",
        "path": "./syntaxes/slx.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "slx",
        "scopes": {
          "macro": [
            "entity.name.function.preprocessor.slx"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "slx",
        "path": "./snippets/slx.code-snippets"
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/shadinglanguagex/SKILL.md"
      }
    ],
    "commands": [
      {
        "command": "slx.compile",
        "category": "SLX",
        "title": "Compile to MaterialX",
        "icon": "$(play)"
      },
      {
        "command": "slx.compileAs",
        "category": "SLX",
        "title": "Compile to MaterialX As..."
      },
      {
        "command": "slx.decompile",
        "category": "SLX",
        "title": "Decompile to SLX",
        "icon": "$(play)"
      },
      {
        "command": "slx.showPreview",
        "category": "SLX",
        "title": "Open MaterialX Preview to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "slx.selectMaterialXVersion",
        "category": "SLX",
        "title": "Select MaterialX Version"
      },
      {
        "command": "slx.installSkill",
        "category": "SLX",
        "title": "Install AI Skill"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "slx.showPreview",
          "when": "editorLangId == slx",
          "group": "navigation"
        },
        {
          "command": "slx.compile",
          "when": "editorLangId == slx",
          "group": "navigation"
        },
        {
          "command": "slx.decompile",
          "when": "resourceExtname =~ /^\\.mtlx$/i",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "slx.showPreview",
          "when": "editorLangId == slx",
          "group": "1_slx"
        },
        {
          "command": "slx.compile",
          "when": "editorLangId == slx",
          "group": "1_slx"
        },
        {
          "command": "slx.compileAs",
          "when": "editorLangId == slx",
          "group": "1_slx"
        },
        {
          "command": "slx.decompile",
          "when": "resourceExtname =~ /^\\.mtlx$/i",
          "group": "1_slx"
        }
      ],
      "commandPalette": [
        {
          "command": "slx.compile",
          "when": "editorLangId == slx"
        },
        {
          "command": "slx.compileAs",
          "when": "editorLangId == slx"
        },
        {
          "command": "slx.decompile",
          "when": "resourceExtname =~ /^\\.mtlx$/i"
        },
        {
          "command": "slx.showPreview",
          "when": "editorLangId == slx"
        },
        {
          "command": "slx.selectMaterialXVersion",
          "when": "editorLangId == slx"
        }
      ]
    },
    "keybindings": [
      {
        "command": "slx.showPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == slx"
      }
    ],
    "configuration": {
      "title": "SLX",
      "properties": {
        "slx.materialxVersion": {
          "type": "string",
          "enum": [
            "1.38.10",
            "1.39.4",
            "1.39.5"
          ],
          "default": "1.39.5",
          "scope": "resource",
          "markdownDescription": "MaterialX version to compile against. A `#version` directive in the file takes precedence."
        },
        "slx.reduceGraph": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Simplify the compiled node graph, for example by folding constants and removing redundant nodes."
        },
        "slx.defaultFunctionBehaviour": {
          "type": "string",
          "enum": [
            "nodedef",
            "nodegraph",
            "inline",
            "comptime"
          ],
          "enumDescriptions": [
            "Functions compile to a NodeDef and its NodeGraph.",
            "Functions compile to a NodeGraph without a NodeDef.",
            "Functions are inlined at each call site.",
            "Functions are evaluated at compile time."
          ],
          "default": "nodedef",
          "scope": "resource",
          "markdownDescription": "How functions compile when they have no `nodedef`, `nodegraph`, `inline` or `comptime` modifier."
        },
        "slx.errorOnMissingGlobals": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Report an error for every `global` variable, because the extension can't pass values for them. When off, globals compile with their initial value, or zero."
        },
        "slx.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Extra folders to search for `#include` and `#library` files, after the folder of the file containing the directive. Relative paths are resolved against the workspace folder."
        },
        "slx.links.nodes": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Make the names of MaterialX nodes in calls links to the node's section of the MaterialX specification, opened with Ctrl+Click. VS Code underlines links, so every node call is underlined while this is on."
        },
        "slx.bracketPairColorization": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Colour-code matching brackets in SLX files by their nesting level, as VS Code does for other languages. Off by default, as in the MaterialX Playground. Turning this on or off sets `editor.language.colorizedBracketPairs` for SLX in the same settings file. Needs `#editor.bracketPairColorization.enabled#`, which is on by default."
        },
        "slx.diagnostics.trigger": {
          "type": "string",
          "enum": [
            "onType",
            "onSave",
            "off"
          ],
          "enumDescriptions": [
            "Check files as you type, after a short pause.",
            "Check files when they are opened or saved.",
            "Only check files when they are compiled or decompiled with an SLX command."
          ],
          "default": "onType",
          "scope": "resource",
          "markdownDescription": "When to compile open SLX files and show their errors in the Problems panel."
        }
      }
    },
