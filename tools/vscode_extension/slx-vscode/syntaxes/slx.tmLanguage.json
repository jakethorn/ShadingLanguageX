{
  "scopeName": "source.slx",
  "name": "SLX",
  "fileTypes": [
    "mxsl"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#modifier-brackets"
    },
    {
      "include": "#class-definition"
    },
    {
      "include": "#using-alias"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#member-access"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.slx",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.slx"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.slx"
            }
          }
        },
        {
          "name": "comment.line.double-slash.slx",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.slx"
            }
          }
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.slx",
          "begin": "^\\s*((#)\\s*(?:include|library))\\b",
          "end": "(?=$|//|/\\*)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.include.slx"
            },
            "2": {
              "name": "punctuation.definition.directive.slx"
            }
          },
          "patterns": [
            {
              "name": "string.quoted.double.include.slx",
              "match": "\"[^\"]*\""
            }
          ]
        },
        {
          "name": "meta.preprocessor.version.slx",
          "match": "^\\s*((#)\\s*version)\\b\\s*([0-9][0-9.]*)?",
          "captures": {
            "1": {
              "name": "keyword.control.directive.version.slx"
            },
            "2": {
              "name": "punctuation.definition.directive.slx"
            },
            "3": {
              "name": "constant.numeric.version.slx"
            }
          }
        },
        {
          "name": "meta.preprocessor.macro.slx",
          "begin": "^\\s*((#)\\s*(?:define|undef))\\b\\s*([A-Za-z_]\\w*)?",
          "end": "(?=$|//|/\\*)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.define.slx"
            },
            "2": {
              "name": "punctuation.definition.directive.slx"
            },
            "3": {
              "name": "entity.name.function.preprocessor.slx"
            }
          },
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#numbers"
            }
          ]
        },
        {
          "name": "meta.preprocessor.conditional.slx",
          "begin": "^\\s*((#)\\s*(?:ifdef|ifndef|if|elifdef|elifndef|elif|else|endif))\\b",
          "end": "(?=$|//|/\\*)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.conditional.slx"
            },
            "2": {
              "name": "punctuation.definition.directive.slx"
            }
          },
          "patterns": [
            {
              "include": "#constants"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "name": "entity.name.function.preprocessor.slx",
              "match": "[A-Za-z_]\\w*"
            }
          ]
        },
        {
          "name": "keyword.control.directive.slx",
          "match": "^\\s*#\\s*\\w+"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.slx",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.slx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.slx"
        }
      }
    },
    "attributes": {
      "name": "meta.attribute.slx",
      "match": "(@@?)(?:([A-Za-z_]\\w*)(\\.))?([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.attribute.slx"
        },
        "2": {
          "name": "variable.parameter.slx"
        },
        "3": {
          "name": "punctuation.accessor.slx"
        },
        "4": {
          "name": "entity.other.attribute-name.slx"
        }
      }
    },
    "modifier-brackets": {
      "name": "meta.modifier.slx",
      "begin": "\\[\\[",
      "end": "\\]\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.modifier.begin.slx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.modifier.end.slx"
        }
      },
      "patterns": [
        {
          "name": "storage.modifier.slx",
          "match": "[A-Za-z_]\\w*"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "class-definition": {
      "match": "\\b(class)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "storage.type.class.slx"
        },
        "2": {
          "name": "entity.name.type.class.slx"
        }
      }
    },
    "using-alias": {
      "match": "\\b(using)\\s+([A-Za-z_]\\w*)\\s*(=)",
      "captures": {
        "1": {
          "name": "keyword.other.using.slx"
        },
        "2": {
          "name": "entity.name.type.alias.slx"
        },
        "3": {
          "name": "keyword.operator.assignment.slx"
        }
      }
    },
    "template-arguments": {
      "match": "(<)\\s*([A-Za-z_]\\w*(?:\\s*,\\s*[A-Za-z_]\\w*)*)\\s*(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.template.begin.slx"
        },
        "2": {
          "patterns": [
            {
              "include": "#types"
            },
            {
              "name": "entity.name.type.slx",
              "match": "[A-Za-z_]\\w*"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.template.end.slx"
        }
      }
    },
    "function-definition": {
      "$comment": "A type, then a name, then an optional template argument list, then an opening parenthesis.",
      "begin": "\\b(?!(?:consteval|namespace|nodegraph|comptime|geomprop|default|mutable|nodedef|uniform|varying|global|inline|return|switch|typeof|break|class|const|false|print|using|case|else|from|null|this|true|for|out|ref|if|to)\\b)([A-Za-z_]\\w*)\\s+([A-Za-z_]\\w*)\\s*(?=(?:<\\s*[A-Za-z_]\\w*(?:\\s*,\\s*[A-Za-z_]\\w*)*\\s*>)?\\s*\\()",
      "end": "(?=\\()",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "#types"
            },
            {
              "name": "entity.name.type.slx",
              "match": "[A-Za-z_]\\w*"
            }
          ]
        },
        "2": {
          "name": "entity.name.function.slx"
        }
      },
      "patterns": [
        {
          "include": "#template-arguments"
        }
      ]
    },
    "function-call": {
      "$comment": "A call: the name, any template arguments, then the argument list. Ends after the closing parenthesis.",
      "patterns": [
        {
          "begin": "\\b(standard_surface_to_UsdPreviewSurface|open_pbr_surface_to_standard_surface|standard_surface_to_open_pbr_surface|chiang_hair_absorption_from_color|deon_hair_absorption_from_melanin|rec709_display_to_lin_rec709|srgb_displayp3_to_lin_rec709|standard_surface_to_gltf_pbr|lin_displayp3_to_lin_rec709|gltf_iridescence_thickness|lin_adobergb_to_lin_rec709|srgb_texture_to_lin_rec709|g18_rec709_to_lin_rec709|g22_rec709_to_lin_rec709|generalized_schlick_bsdf|generalized_schlick_edf|oren_nayar_diffuse_bsdf|LamaGeneralizedSchlick|adobergb_to_lin_rec709|chiang_hair_roughness|g22_ap1_to_lin_rec709|glossiness_anisotropy|gltf_anisotropy_image|acescg_to_lin_rec709|geompropvalueuniform|roughness_anisotropy|burley_diffuse_bsdf|open_pbr_anisotropy|triplanarprojection|UsdPreviewSurface|directional_light|disney_principled|hextilednormalmap|UsdPrimvarReader|ambientocclusion|chiang_hair_bsdf|disney_brdf_2012|disney_bsdf_2015|open_pbr_surface|standard_surface|tiledcloverleafs|translucent_bsdf|LamaIridescence|LamaTranslucent|anisotropic_vdf|dielectric_bsdf|gltf_colorimage|subsurface_bsdf|surfacematerial|transformmatrix|transformnormal|transformvector|LamaDielectric|UsdTransform2d|absorption_vdf|conductor_bsdf|gltf_normalmap|heighttonormal|roughness_dual|thin_film_bsdf|transformpoint|unifiednoise2d|unifiednoise3d|volumematerial|LamaConductor|geompropvalue|hextiledimage|ramp_gradient|surface_unlit|tiledhexagons|viewdirection|worleynoise2d|worleynoise3d|LamaEmission|UsdUVTexture|artistic_ior|checkerboard|colorcorrect|creatematrix|crossproduct|disjointover|displacement|invertmatrix|latlongimage|measured_edf|thin_surface|tiledcircles|trianglewave|LamaDiffuse|LamaSurface|arrayappend|cellnoise2d|cellnoise3d|conical_edf|curveadjust|determinant|facingratio|gooch_shade|ifgreatereq|point_light|randomcolor|randomfloat|uniform_edf|cloverleaf|crosshatch|difference|dotproduct|gltf_image|sheen_bsdf|smoothstep|spot_light|tiledimage|LamaLayer|LamaSheen|bitangent|blackbody|fractal2d|fractal3d|geomcolor|hsvadjust|ifgreater|luminance|magnitude|normalize|normalmap|safepower|separate2|separate3|separate4|transpose|unpremult|combine2|combine3|combine4|constant|contrast|distance|gltf_pbr|hsvtorgb|multiply|position|rgbtohsv|rotate2d|rotate3d|saturate|separate|subtract|texcoord|LamaAdd|LamaMix|LamaSSS|combine|convert|extract|flake2d|flake3d|hexagon|ifequal|noise2d|noise3d|outside|overlay|place2d|premult|reflect|refract|splitlr|splittb|surface|swizzle|tangent|absval|circle|divide|inside|invert|modulo|normal|ramplr|ramptb|screen|volume|atan2|clamp|dodge|floor|fract|frame|image|layer|light|matte|minus|power|ramp4|range|remap|round|acos|asin|blur|bump|burn|ceil|grid|line|mask|over|plus|ramp|sign|sqrt|time|add|and|cos|dot|exp|max|min|mix|not|sin|tan|xor|in|ln|or)\\s*(?=(?:<\\s*[A-Za-z_]\\w*(?:\\s*,\\s*[A-Za-z_]\\w*)*\\s*>)?\\s*\\()",
          "end": "(?<=\\))",
          "beginCaptures": {
            "1": {
              "name": "support.function.slx"
            }
          },
          "patterns": [
            {
              "include": "#template-arguments"
            },
            {
              "include": "#call-arguments"
            }
          ]
        },
        {
          "begin": "\\b(?!(?:consteval|namespace|nodegraph|comptime|geomprop|default|mutable|nodedef|uniform|varying|global|inline|return|switch|typeof|break|class|const|false|print|using|case|else|from|null|this|true|for|out|ref|if|to|displacementshader|surfaceshader|volumeshader|lightshader|filename|geomname|material|matrix33|matrix44|boolean|integer|vector2|vector3|vector4|color3|color4|string|float|BSDF|auto|bool|mat3|mat4|vec2|vec3|vec4|void|EDF|VDF|int|T)\\b)([A-Za-z_]\\w*)\\s*(?=(?:<\\s*[A-Za-z_]\\w*(?:\\s*,\\s*[A-Za-z_]\\w*)*\\s*>)?\\s*\\()",
          "end": "(?<=\\))",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.call.slx"
            }
          },
          "patterns": [
            {
              "include": "#template-arguments"
            },
            {
              "include": "#call-arguments"
            }
          ]
        }
      ]
    },
    "call-arguments": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.parens.begin.slx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.slx"
        }
      },
      "patterns": [
        {
          "include": "#named-argument"
        },
        {
          "include": "#parens"
        },
        {
          "include": "$self"
        }
      ]
    },
    "named-argument": {
      "$comment": "The name in a `name = value` argument: the first word after the opening parenthesis, a comma or the start of a line.",
      "match": "(?:(?<=[(,])|^)\\s*([A-Za-z_]\\w*)\\s*(?==(?!=))",
      "captures": {
        "1": {
          "name": "variable.parameter.named-argument.slx"
        }
      }
    },
    "parens": {
      "$comment": "Parentheses inside an argument list, matched so that their closing parenthesis doesn't end the list.",
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.parens.begin.slx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.slx"
        }
      },
      "patterns": [
        {
          "include": "#parens"
        },
        {
          "include": "$self"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.slx",
          "match": "\\b(?:default|return|switch|break|case|else|from|for|if|to)\\b"
        },
        {
          "name": "storage.modifier.slx",
          "match": "\\b(?:consteval|nodegraph|comptime|geomprop|mutable|nodedef|uniform|varying|global|inline|const|out|ref)\\b"
        },
        {
          "name": "storage.type.class.slx",
          "match": "\\bclass\\b"
        },
        {
          "name": "variable.language.this.slx",
          "match": "\\bthis\\b"
        },
        {
          "name": "keyword.other.slx",
          "match": "\\b(?:namespace|typeof|print|using)\\b"
        }
      ]
    },
    "types": {
      "name": "storage.type.slx",
      "match": "\\b(?:displacementshader|surfaceshader|volumeshader|lightshader|filename|geomname|material|matrix33|matrix44|boolean|integer|vector2|vector3|vector4|color3|color4|string|float|BSDF|auto|bool|mat3|mat4|vec2|vec3|vec4|void|EDF|VDF|int|T)\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.slx",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "support.constant.macro.slx",
          "match": "\\b__(?:MAIN|INCLUDE|FILE|LINE)__\\b"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.slx",
      "match": "(?<![\\w.])(?:\\d+\\.\\d*(?:[eE][+-]?\\d+)?|\\.\\d+(?:[eE][+-]?\\d+)?|\\d+[eE][+-]?\\d+|\\d+)[fF]?(?![\\w.])"
    },
    "member-access": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)\\b(?!\\s*\\()",
      "captures": {
        "1": {
          "name": "punctuation.accessor.slx"
        },
        "2": {
          "name": "variable.other.member.slx"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.increment-decrement.slx",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.comparison.slx",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.compound.slx",
          "match": "[-+*/%^&|]="
        },
        {
          "name": "keyword.operator.logical.slx",
          "match": "&&|\\|\\||[!&|]"
        },
        {
          "name": "keyword.operator.slx",
          "match": "=>|->|::"
        },
        {
          "name": "keyword.operator.assignment.slx",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.slx",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.arithmetic.slx",
          "match": "[-+*/%^]"
        },
        {
          "name": "keyword.operator.range.slx",
          "match": ":"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.slx",
          "match": ";"
        },
        {
          "name": "punctuation.separator.delimiter.slx",
          "match": ","
        },
        {
          "name": "punctuation.accessor.slx",
          "match": "\\."
        },
        {
          "name": "punctuation.section.block.begin.slx",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.slx",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.parens.begin.slx",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.slx",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.slx",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.slx",
          "match": "\\]"
        }
      ]
    }
  }
}
