// glsl macros

#define dot dotproduct
#define pow power
#define mod modulo
#define iTime time()
#define iResolution vec2{1, 1}

inline T glsl_mix<float, vec2, vec3, vec4>(T bg, T fg, float mix)
{
    return mix(fg, bg, mix);
}

#define mix glsl_mix

inline T glsl_smoothstep<float, vec2, vec3, vec4>(T low, T high, T in)
{
    T t = clamp((in - low) / (high - low), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

inline T glsl_smoothstep<vec2, vec3, vec4>(float low, float high, T in)
{
    T t = clamp((in - low) / (high - low), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

#define smoothstep glsl_smoothstep

// code

inline float sum2(vec2 v)
{
    return dot(v, vec2{1});
}

inline float h31(mutable vec3 p3)
{
	p3 = fract(p3 * 0.1031);
	p3 += dot(p3, p3.yzx + 333.3456);
	return fract(sum2(p3.xy) * p3.z);
}

inline float h21(vec2 p)
{
    return h31(p.xyx);
}

inline float n31(mutable vec3 p)
{
	const vec3 s = vec3{7, 157, 113};

	vec3 ip = floor(p);
	p = fract(p);
	p = p * p * (3.0 - 2.0 * p);
	mutable vec4 h = vec4{0, s.yz, sum2(s.yz)} + dot(ip, s);
	h = mix(fract(sin(h) * 43758.545), fract(sin(h + s.x) * 43758.545), p.x);
	h.xy = mix(h.xz, h.yw, p.y);
	return mix(h.x, h.y, p.z);
}

inline float fbm(mutable vec3 p, int octaves, mutable float roughness)
{
	mutable float sum = 0.0;
	mutable float amp = 1.0;
	mutable float tot = 0.0;
	roughness = clamp(roughness, 0.0, 1.0);
	for (int i from 0 to octaves)
	{
		sum += amp * n31(p);
		tot += amp;
		amp *= roughness;
		p *= 2.0;
	}
	return sum / tot;
}

inline vec3 randomPos(float seed)
{
	vec4 s = vec4{seed, 0, 1, 2};
	return vec3{h21(s.xy), h21(s.xz), h21(s.xw)} * 100.0 + 100.0;
}

inline float fbmDistorted(mutable vec3 p)
{
	p += (vec3{n31(p + randomPos(0.0)), n31(p + randomPos(1.0)), n31(p + randomPos(2.0))} * 2.0 - 1.0) * 1.12;
	return fbm(p, 8, 0.5);
}

inline float musgraveFbm(mutable vec3 p, float octaves, float dimension, float lacunarity)
{
	mutable float sum = 0.0;
	mutable float amp = 1.0;
	float m = pow(lacunarity, -dimension);
	for (float i from 0.0 to octaves)
	{
		float n = n31(p) * 2.0 - 1.0;
		sum += n * amp;
		amp *= m;
		p *= lacunarity;
	}
	return sum;
}

inline vec3 waveFbmX(vec3 p)
{
	mutable float n = p.x * 20.0;
	n += 0.4 * fbm(p * 3.0, 3, 3.0);
	return vec3{sin(n) * 0.5 + 0.5, p.yz};
}

inline float remap01(float f, float in1, float in2)
{
    return clamp((f - in1) / (in2 - in1), 0.0, 1.0);
}

inline vec3 matWood(vec3 p)
{
	mutable float n1 = fbmDistorted(p * vec3{7.8, 1.17, 1.17});
	n1 = mix(n1, 1.0, 0.2);
	mutable float n2 = mix(musgraveFbm(vec3{n1 * 4.6}, 8.0, 0.0, 2.5), n1, 0.85);
	float dirt = 1.0 - musgraveFbm(waveFbmX(p * vec3{0.01, 0.15, 0.15}), 15.0, 0.26, 2.4) * 0.4;
	float grain = 1.0 - smoothstep(0.2, 1.0, musgraveFbm(p * vec3{500, 6, 1}, 2.0, 2.0, 2.5)) * 0.2;
	n2 *= dirt * grain;

	return mix(mix(vec3{0.03, 0.012, 0.003}, vec3{0.25, 0.11, 0.04}, remap01(n2, 0.19, 0.56)), vec3{0.52, 0.32, 0.19}, remap01(n2, 0.56, 1.0));
}

inline void mainImage(out vec4 fragColor, vec2 fc)
{
    vec3 p = vec3{fc / iResolution.y, 0};
    fragColor = vec4{matWood(p), 0};
}

mutable vec4 fragColor;
mainImage(out fragColor, texcoord());

color3 c = color3{fragColor};
surfaceshader surface = standard_surface(base_color = c, specular_roughness = 1.0);
material wood_material = surfacematerial(surface);
