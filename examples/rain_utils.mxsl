// glsl macros

#define dot dotproduct
#define pow power
#define mod modulo
#define abs absval
#define length magnitude
#define iTime time()
#define iResolution vec2{1, 1}

inline T glsl_mix<float, vec2, vec3, vec4>(T bg, T fg, float mix)
{
    return mix(fg, bg, mix);
}

#define mix glsl_mix

inline T glsl_smoothstep<float, vec2, vec3, vec4>(T low, T high, T in)
{
    T t = clamp((in - low) / (high - low), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

inline T glsl_smoothstep<vec2, vec3, vec4>(float low, float high, T in)
{
    T t = clamp((in - low) / (high - low), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

#define smoothstep glsl_smoothstep

// code

#define S smoothstep

inline vec3 N13(float p)
{
   mutable vec3 p3 = fract(vec3{p} * vec3{0.1031, 0.11369, 0.13787});
   p3 += dot(p3, p3.yzx + 19.19);
   return fract(vec3{(p3.x + p3.y) * p3.z, (p3.x + p3.z) * p3.y, (p3.y + p3.z) * p3.x});
}

inline vec4 N14(float t)
{
	return fract(sin(t * vec4{123.0, 1024.0, 1456.0, 264.0}) * vec4{6547.0, 345.0, 8799.0, 1564.0});
}

inline float N(float t)
{
    return fract(sin(t * 12345.564) * 7658.76);
}

inline float Saw(float b, float t)
{
	return S(0.0, b, t) * S(1.0, b, t);
}

inline vec2 DropLayer2(mutable vec2 uv, float t)
{
    vec2 UV = uv;

    uv.y += t * 0.75;
    vec2 a = vec2{6.0, 1.0};
    vec2 grid = a * 2.0;
    mutable vec2 id = floor(uv * grid);

    float colShift = N(id.x);
    uv.y += colShift;

    id = floor(uv * grid);
    vec3 n = N13(id.x * 35.2 + id.y * 2376.1);
    vec2 st = fract(uv * grid) - vec2{0.5, 0};

    mutable float x = n.x - 0.5;

    mutable float y = UV.y * 20.0;
    float wiggle = sin(y+sin(y));
    x += wiggle * (0.5 - abs(x)) * (n.z - 0.5);
    x *= 0.7;
    float ti = fract(t + n.z);
    y = (Saw(0.85, ti) - 0.5) * 0.9 + 0.5;
    vec2 p = vec2{x, y};

    float d = length((st - p) * a.yx);

    float mainDrop = S(0.4, 0.0, d);

    float r = sqrt(S(1.0, y, st.y));
    float cd = abs(st.x - x);
    mutable float trail = S(0.23 * r, 0.15 * r * r, cd);
    float trailFront = S(-0.02, 0.02, st.y - y);
    trail *= trailFront * r * r;

    y = UV.y;
    float trail2 = S(0.2 * r, 0.0, cd);
    y = fract(y * 10.0) + (st.y - 0.5);
    float dd = length(st - vec2{x, y});
    float droplets = S(0.3, 0.0, dd);
    float m = mainDrop + droplets * r * trailFront;

    return vec2{m, trail};
}

inline float StaticDrops(mutable vec2 uv, float t)
{
	uv *= 40.0;

    vec2 id = floor(uv);
    uv = fract(uv) - 0.5;
    vec3 n = N13(id.x * 107.45 + id.y * 3543.654);
    vec2 p = (n.xy - 0.5) * 0.7;
    float d = length(uv - p);

    float fade = Saw(0.025, fract(t + n.z));
    float c = S(0.3, 0.0, d) * fract(n.z * 10.0) * fade;
    return c;
}

inline vec2 Drops(vec2 uv, float t, float l0, float l1, float l2)
{
    float s = StaticDrops(uv, t) * l0;

    vec2 m1 = DropLayer2(uv, t) * l1;
    vec2 m2 = DropLayer2(uv * 1.85, t) * l2;

    mutable float c = s + m1.x + m2.x;
    c = S(0.3, 1.0, c);

    return vec2{c, max(m1.y * l0, m2.y * l1)};
}

inline vec2 calculate_rain_uvs(vec2 fragCoord)
{
	vec2 uv = (fragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;
    vec2 UV = fragCoord.xy / iResolution.xy;
    float T_ = iTime;

    float t = T_ * 0.1;

    float rainAmount = sin(T_ * 0.05) * 0.3 + 0.7;

    float maxBlur = mix(3.0, 6.0, rainAmount);
    float minBlur = 2.0;

    float story = 0.0;
    float heart = 0.0;

    float staticDrops = S(-0.5, 1.0, rainAmount) * 2.0;
    float layer1 = S(0.25, 0.75, rainAmount);
    float layer2 = S(0.0, 0.5, rainAmount);

    vec2 c = Drops(uv, t, staticDrops, layer1, layer2);

    vec2 e = vec2{0.001, 0.0};
    vec2 uv_e = uv + e;
    vec2 uv_e_yx = uv + e.yx;
    float cx = Drops(uv_e, t, staticDrops, layer1, layer2).x;
    float cy = Drops(uv_e_yx, t, staticDrops, layer1, layer2).x;
    vec2 n = vec2{cx - c.x, cy - c.x};

    return UV + n;
}

#undef dot
#undef pow
#undef mod
#undef abs
#undef length
#undef iTime
#undef iResolution

#undef mix
#undef smoothstep
#undef S
