// Numeric test for color3
color3 color3_test(color3 color1 = color3{-1,-1,-1}, color3 color2 = color3{1e-5,2,2})
{
  color3 c = -color3{1e-6, -5, -5}; // unary -color = invert(val,0)
  color3 c2 = +color3{1e-6, -5, -5}; // unary +color = no-op
  return color1 + color2 + c + c2;
}
color3 color3_test_out = color3_test(color1 = color3{-1, 0.094118, 0.031373}, color2 = color3{2e-5, 1, 1});

// Numeric test for color4
color4 color4_test(color4 color1 = color4{-1,-1,-1,-1}, color4 color2 = color4{1e-5,2,2,1})
{
  color4 c = -color4{1e-6, -5, -5, -5};
  return color1 + color2 + c;
}
color4 color4_test_out = color4_test(color1 = color4{-1, 0.094118, 0.031373, -1}, color2 = color4{2e-5, 1, 1, -1});


// Numeric test for vec3
vec3 vec3_test(vec3 color1 = vec3{-1,-1,-1}, vec3 color2 = vec3{1e-5,2,2})
{
  vec3 v = -vec3{1e-6, -5, -5};
  return color1 + color2 + v;
}
vec3 vec3_test_out = vec3_test(color1 = vec3{-1, 0.094118, 0.031373}, color2 = vec3{2e-5, 1, 1});

// Numeric test for float
float float_test(float color1 = -1, float color2 = 1e-5)
{
  float v =  1e-6;
  return color1 + color2 + v;
}
float float_test_out = float_test(color1 = -1, color2 = 2e-5);

// Numeric test for int
int int_test(int color1 = -1, int color2 = -3)
{
  int v =  -3;
  return color1 + color2 + v;
}
int int_test_out = int_test(color1 = -1, color2 = -1000000000);
