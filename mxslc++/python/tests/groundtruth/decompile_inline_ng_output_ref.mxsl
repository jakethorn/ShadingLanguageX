{color3 base_color_output, float specular_roughness_output, vec3 coat_normal_output, vec3 normal_output, vec3 tangent_output} Canyon_Maple_Dark_Wood =>
{
    vec3 onthefly_4 = normal("world");
    vec3 onthefly_6 = tangent("world");
    vec2 node_texcoord_vector2_8 = texcoord(0);
    vec2 node_multiply_9 = node_texcoord_vector2_8 * 2.0;
    @GLSLFX_usage "normal"
    @expose "true"
    vec3 node_image_vector3_10 = image(
        "textures/Canyon_Maple_Dark_Wood_Normal.png",
        "",
        vec3{},
        node_multiply_9,
        "periodic",
        "periodic",
        "linear",
        "",
        0,
        "constant"
    );
    @GLSLFX_usage "mask"
    @expose "true"
    vec3 node_image_vector3_12 = image(
        "textures/Canyon_Maple_Dark_Wood_Mask.png",
        "",
        vec3{},
        node_multiply_9,
        "periodic",
        "periodic",
        "linear",
        "",
        0,
        "constant"
    );
    float node_extract_11 = node_image_vector3_12.x;
    float node_mix_3 = mix(0.915, 0.0, node_extract_11);
    vec3 node_normalmap = normalmap(node_image_vector3_10);
    @GLSLFX_usage "baseColor"
    @expose "true"
    color3 node_image_color3_2 = image(
        @colorspace "srgb_texture" "textures/Canyon_Maple_Dark_Wood_baseColor.png",
        "",
        color3{},
        node_multiply_9,
        "periodic",
        "periodic",
        "linear",
        "",
        0,
        "constant"
    );
    return {node_image_color3_2, node_mix_3, onthefly_4, node_normalmap, onthefly_6};
}

surfaceshader SR_Canyon_Maple_Dark_Wood = standard_surface(
    0.8,
    Canyon_Maple_Dark_Wood.base_color_output,
    0.0,
    0.0,
    1.0,
    color3{1.0},
    Canyon_Maple_Dark_Wood.specular_roughness_output,
    1.5,
    0.0,
    0.0,
    0.0,
    color3{1.0},
    0.0,
    color3{},
    0.0,
    0.0,
    0.0,
    0.0,
    color3{1.0},
    color3{1.0},
    1.0,
    0.0,
    0.0,
    color3{1.0},
    0.3,
    0.0,
    color3{1.0},
    0.1,
    0.0,
    0.0,
    1.5,
    Canyon_Maple_Dark_Wood.coat_normal_output,
    0.0,
    0.0,
    0.0,
    1.5,
    0.0,
    color3{1.0},
    color3{1.0},
    false,
    Canyon_Maple_Dark_Wood.normal_output,
    Canyon_Maple_Dark_Wood.tangent_output
);
material Canyon_Maple_Dark_Wood = surfacematerial(SR_Canyon_Maple_Dark_Wood);
