    <input name="tangent" type="vector3" value="0, 0, 0" defaultgeomprop="Tworld" />
  </nodedef>
  <nodegraph name="NG_slx_standard_surface" nodedef="ND_slx_standard_surface">
    <multiply name="var__0" type="float">
