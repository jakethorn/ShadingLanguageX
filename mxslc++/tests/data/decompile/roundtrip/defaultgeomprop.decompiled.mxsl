[[nodedef]]
vec2 quantize(float scale, vec2 uv = geomprop(UV0), float bias = 0.5)
{
    return floor(uv * scale) / scale + bias;
}

[[nodegraph]]
vec3 offset(vec3 p = geomprop(Pworld), float amount = 0.1)
{
    return p + normal() * amount;
}

vec2 a = quantize(4.0);
vec2 b = quantize(4.0, bias = 0.25);
vec2 c = quantize(8.0, texcoord(), 0.0);
vec3 d = offset() * 2.0;
