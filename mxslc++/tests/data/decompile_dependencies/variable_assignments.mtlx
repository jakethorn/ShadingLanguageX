<?xml version="1.0"?>
<!-- the values that are assigned to variables, e.g., var__x__1, before their previous values -->
<materialx version="1.39">
  <magnitude name="m" type="float">
    <input name="in" type="vector3" nodename="var__v__1" />
  </magnitude>
  <switch name="var__v__1" type="vector3">
    <input name="in1" type="vector3" nodename="var__1" />
    <input name="in2" type="vector3" nodename="var__2" />
    <input name="in3" type="vector3" nodename="var__3" />
    <input name="which" type="integer" value="0" />
  </switch>
  <combine3 name="var__3" type="vector3">
    <input name="in1" type="float" output="outx" nodename="var__0" />
    <input name="in2" type="float" output="outy" nodename="var__0" />
    <input name="in3" type="float" value="1" />
  </combine3>
  <combine3 name="var__2" type="vector3">
    <input name="in1" type="float" output="outx" nodename="var__0" />
    <input name="in2" type="float" value="1" />
    <input name="in3" type="float" output="outz" nodename="var__0" />
  </combine3>
  <combine3 name="var__1" type="vector3">
    <input name="in1" type="float" value="1" />
    <input name="in2" type="float" output="outy" nodename="var__0" />
    <input name="in3" type="float" output="outz" nodename="var__0" />
  </combine3>
  <separate3 name="var__0" type="multioutput">
    <input name="in" type="vector3" nodename="v" />
  </separate3>
  <position name="v" type="vector3" />
  <add name="z" type="float">
    <input name="in1" type="float" nodename="var__x__1" />
    <input name="in2" type="float" value="1" />
  </add>
  <multiply name="var__x__1" type="float">
    <input name="in1" type="float" nodename="x" />
    <input name="in2" type="float" value="2" />
  </multiply>
  <add name="y" type="float">
    <input name="in1" type="float" nodename="x" />
    <input name="in2" type="float" value="1" />
  </add>
  <constant name="x" type="float">
    <input name="value" type="float" value="1" />
  </constant>
</materialx>
