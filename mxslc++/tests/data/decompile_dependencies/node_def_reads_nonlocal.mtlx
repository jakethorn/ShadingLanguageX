<?xml version="1.0"?>
<!-- a node def that reads a nonlocal variable, before the node of the variable -->
<materialx version="1.39">
  <add_amount name="y" type="float">
    <input name="x" type="float" value="1" />
    <input name="nonlocal_in__amount" type="float" nodename="amount" />
  </add_amount>
  <nodegraph name="NG_add_amount" nodedef="ND_add_amount">
    <add name="var__0" type="float">
      <input name="in1" type="float" interfacename="x" />
      <input name="in2" type="float" interfacename="nonlocal_in__amount" />
    </add>
    <output name="out" type="float" nodename="var__0" />
  </nodegraph>
  <nodedef name="ND_add_amount" node="add_amount">
    <output name="out" type="float" />
    <input name="x" type="float" value="0" />
    <input name="nonlocal_in__amount" type="float" />
  </nodedef>
  <constant name="amount" type="float">
    <input name="value" type="float" value="0.25" />
  </constant>
</materialx>
