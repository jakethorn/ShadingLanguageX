<?xml version="1.0"?>
<!-- Calls whose overloads accept the same arguments, but return different types, which no template type can select, are
     assigned to a typed variable, e.g., `vec3 var_1 = fractal2d(-1.0, lacunarity = k);`, rather than inlined, which
     would select the first overload, i.e., ND_fractal2d_vector2FA, or ND_foo. The type of an output selects it too. -->
<materialx version="1.39">
  <nodedef name="ND_foo" node="foo">
    <output name="out" type="vector2" />
    <input name="a" type="float" value="0" />
  </nodedef>
  <nodegraph name="NG_foo" nodedef="ND_foo">
    <convert name="var__0" type="vector2">
      <input name="in" type="float" interfacename="a" />
    </convert>
    <output name="out" type="vector2" nodename="var__0" />
  </nodegraph>
  <nodedef name="ND_foo2" node="foo">
    <output name="out" type="vector3" />
    <input name="a" type="float" value="0" />
  </nodedef>
  <nodegraph name="NG_foo2" nodedef="ND_foo2">
    <convert name="var__0" type="vector3">
      <input name="in" type="float" interfacename="a" />
    </convert>
    <output name="out" type="vector3" nodename="var__0" />
  </nodegraph>
  <nodedef name="ND_noise" node="noise">
    <output name="out" type="vector3" />
    <input name="amplitude" type="float" value="0" />
  </nodedef>
  <nodegraph name="NG_noise" nodedef="ND_noise">
    <fractal2d name="var__0" type="vector3">
      <input name="amplitude" type="float" interfacename="amplitude" />
      <input name="lacunarity" type="float" value="2" />
    </fractal2d>
    <output name="out" type="vector3" nodename="var__0" />
  </nodegraph>
  <constant name="k" type="float">
    <input name="value" type="float" value="2" />
  </constant>
  <fractal2d name="var__1" type="vector3">
    <input name="amplitude" type="float" value="-1" />
    <input name="lacunarity" type="float" nodename="k" />
  </fractal2d>
  <magnitude name="m" type="float">
    <input name="in" type="vector3" nodename="var__1" />
  </magnitude>
  <foo name="var__2" type="vector3">
    <input name="a" type="float" nodename="k" />
  </foo>
  <magnitude name="l" type="float">
    <input name="in" type="vector3" nodename="var__2" />
  </magnitude>
  <fractal2d name="var__3" type="vector3">
    <input name="amplitude" type="float" value="-2" />
  </fractal2d>
</materialx>
