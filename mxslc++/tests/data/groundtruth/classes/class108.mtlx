<?xml version="1.0"?>
<materialx version="1.39">
  <nodegraph name="NG_Point_extent">
    <Point_extent_max_dim name="var__0" type="float">
      <input name="nonlocal_in__x" type="float" interfacename="this__x" />
      <input name="nonlocal_in__y" type="float" interfacename="this__y" />
    </Point_extent_max_dim>
    <subtract name="var__1" type="float">
      <input name="in1" type="float" nodename="var__0" />
      <input name="in2" type="float" interfacename="offset" />
    </subtract>
    <output name="out" type="float" nodename="var__1" />
  </nodegraph>
  <nodegraph name="NG_Point_extent_max_dim">
    <max name="var__0" type="float">
      <input name="in1" type="float" interfacename="nonlocal_in__x" />
      <input name="in2" type="float" interfacename="nonlocal_in__y" />
    </max>
    <output name="out" type="float" nodename="var__0" />
  </nodegraph>
  <nodegraph name="NG_Sphere_extent">
    <Point_extent name="var__0" type="float">
      <input name="offset" type="float" interfacename="this__radius" />
      <input name="this__x" type="float" interfacename="p__x" />
      <input name="this__y" type="float" interfacename="p__y" />
    </Point_extent>
    <output name="out" type="float" nodename="var__0" />
  </nodegraph>
  <Sphere_extent name="var__0" type="float">
    <input name="p__x" type="float" value="1" />
    <input name="p__y" type="float" value="2" />
    <input name="this__radius" type="float" value="3" />
  </Sphere_extent>
</materialx>
