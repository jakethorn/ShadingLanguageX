auto a = typeof(mat3);
constant(a.name);
constant(a.str);

using Point = {float, string};

auto b = typeof(Point);
constant(b.name);
constant(b.str);

class Sphere
{
	float radius;
	vec3 center;
};

auto c = typeof(Sphere);
constant(c.name);
constant(c.str);

inline string foo<vec2, vec3, BSDF, mat4>()
{
    return typeof(T).name;
}

constant(foo<vec2>());
constant(foo<vec3>());
constant(foo<BSDF>());
constant(foo<mat4>());
