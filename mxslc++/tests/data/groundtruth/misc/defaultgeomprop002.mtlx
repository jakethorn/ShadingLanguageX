<?xml version="1.0"?>
<materialx version="1.39">
  <nodedef name="ND_foo" node="foo">
    <output name="out" type="vector3" />
    <input name="a" type="vector3" defaultgeomprop="Tworld" />
    <input name="b" type="vector3" defaultgeomprop="Bobject" />
    <input name="c" type="vector2" defaultgeomprop="UV0" />
  </nodedef>
  <nodegraph name="NG_foo" nodedef="ND_foo">
    <add name="var__0" type="vector3">
      <input name="in1" type="vector3" interfacename="a" />
