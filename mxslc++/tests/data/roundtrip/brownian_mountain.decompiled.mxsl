vec2 uv = position().xy;
float scale2 = 2.0 * 2.0;
mutable float height = 0.0 + noise2d(texcoord = uv / scale2) * scale2;
mutable float scale = 2.0 * 2.0;
float scale3 = scale * scale;
height += noise2d(texcoord = uv / scale3) * scale3;
scale *= 2.0;
float scale4 = scale * scale;
height += noise2d(texcoord = uv / scale4) * scale4;
scale *= 2.0;
float scale5 = scale * scale;
height += noise2d(texcoord = uv / scale5) * scale5;
scale *= 2.0;
surfaceshader s = standard_surface(
    base_color = color3{0.82, 0.796, 0.761},
    metalness = 0.0,
    specular_roughness = 1.0
);
displacementshader d = displacement(height);
material m = surfacematerial(s, displacementshader = d);
