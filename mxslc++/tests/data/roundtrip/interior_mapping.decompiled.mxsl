vec2 uv = 1.0 - texcoord();
vec3 origin = vec3{uv * 2.0 - 1.0, 1.0};
vec3 view_dir = viewdirection("object");
vec3 dn = (-origin - 1.0) / view_dir;
vec3 dp = (-origin + 1.0) / view_dir;
vec3 d_min = max(dn, dp);
vec3 room_pos = origin + view_dir * min(min(d_min.x, d_min.y), d_min.z);
color3 walls = if (room_pos.x > 0.99) { color3{0.0, 0.0, 1.0} } else if (-0.99 > room_pos.x) { color3{1.0, 0.0, 0.0} } else { color3{1.0, 1.0, 0.0} };
float glow = (1.2 - magnitude(room_pos) / 1.732) ^ 4.0;
surfaceshader surface = open_pbr_surface(base_color = walls * glow, specular_roughness = 1.0);
material parallax_mat = surfacematerial(surface);
