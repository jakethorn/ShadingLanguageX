vec3 p = position();
mutable float x = p.x;
x = x * 2.0;
x += p.y;
x -= 1.0;
x *= x;
x /= 4.0;
x ^= 2.0;
x %= 3.0;
mutable float t = time();
t++;
++t;
t--;
--t;
mutable bool flag = p.x > 0.5;
flag &= p.y > 0.5;
flag |= p.z > 0.5;
mutable vec3 q = normal();
q.y = x;
q.xz = p.zx;
q = q * t;
color3 c = if (flag) { color3{q} } else { color3{} };
