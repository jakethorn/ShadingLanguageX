float add_one(float x)
{
    return x + 1.0;
}

float add_two(float x)
{
    float y = add_one(x);
    return add_one(y);
}

vec3 remap(vec3 v, float scale = 2.0)
{
    vec3 scaled = v * scale;
    return scaled - 1.0;
}

float a = add_two(randomfloat());
vec3 b = remap(position());
vec3 c = remap(normal(), 0.5);
