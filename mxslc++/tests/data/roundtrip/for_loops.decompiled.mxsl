vec2 uv = texcoord();
vec2 center = vec2{randomfloat(1, seed = 0), randomfloat(1, seed = 1)};
mutable color3 c = if (0.1 > distance(center, uv)) { randomcolor(1) } else { color3{1.0} };
vec2 center2 = vec2{randomfloat(2, seed = 0), randomfloat(2, seed = 1)};
c = if (0.1 > distance(center2, uv)) { randomcolor(2) };
vec2 center3 = vec2{randomfloat(3, seed = 0), randomfloat(3, seed = 1)};
c = if (0.1 > distance(center3, uv)) { randomcolor(3) };
vec2 center4 = vec2{randomfloat(4, seed = 0), randomfloat(4, seed = 1)};
c = if (0.1 > distance(center4, uv)) { randomcolor(4) };
mutable float height = 0.0 + noise2d(1.0, 0.0, uv * 1.0) / 1.0;
mutable float scale = 1.0 * 2.0;
height += noise2d(1.0, 0.0, uv * scale) / scale;
scale *= 2.0;
height += noise2d(1.0, 0.0, uv * scale) / scale;
scale *= 2.0;
height += noise2d(1.0, 0.0, uv * scale) / scale;
scale *= 2.0;
mutable vec3 blur = vec3{} + position() * 0.25;
blur += position() * 0.5;
blur += position() * 1.0;
surfaceshader s = standard_surface(base_color = c * height, normal = normalize(blur));
