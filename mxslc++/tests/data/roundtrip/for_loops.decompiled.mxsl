vec2 uv = texcoord();
vec2 center = vec2{randomfloat(1, seed = 0), randomfloat(1, seed = 1)};
vec2 center2 = vec2{randomfloat(2, seed = 0), randomfloat(2, seed = 1)};
vec2 center3 = vec2{randomfloat(3, seed = 0), randomfloat(3, seed = 1)};
vec2 center4 = vec2{randomfloat(4, seed = 0), randomfloat(4, seed = 1)};
float var_28 = 1.0 * 2.0;
float var_33 = var_28 * 2.0;
float var_38 = var_33 * 2.0;
var_38 * 2.0;
surfaceshader s = standard_surface(base_color = (if (0.1 > distance(center4, uv)) { randomcolor(4) } else if (0.1 > distance(center3, uv)) { randomcolor(3) } else if (0.1 > distance(center2, uv)) { randomcolor(2) } else if (0.1 > distance(center, uv)) { randomcolor(1) } else { color3{1.0} }) * (0.0 + noise2d<float>(1.0, 0.0, uv * 1.0) / 1.0 + noise2d<float>(1.0, 0.0, uv * var_28) / var_28 + noise2d<float>(1.0, 0.0, uv * var_33) / var_33 + noise2d<float>(1.0, 0.0, uv * var_38) / var_38), normal = normalize(vec3{} + position() * 0.25 + position() * 0.5 + position() * 1.0));
