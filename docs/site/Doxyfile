# Doxygen configuration for the C++ API reference. Run by conf.py, which feeds
# the XML output to Breathe. Only settings that differ from the defaults.

PROJECT_NAME          = mxslc++

# The public API. Add a header here to document it.
INPUT                 = ../../mxslc++/include/compile.h \
                        ../../mxslc++/include/CompileOptions.h \
                        ../../mxslc++/include/preprocess/Macro.h \
                        ../../mxslc++/include/Primitive.h \
                        ../../mxslc++/include/runtime/interface.h \
                        ../../mxslc++/include/runtime/variables/Variable.h \
                        ../../mxslc++/include/runtime/Type.h \
                        ../../mxslc++/include/decompile/decompile.h \
                        ../../mxslc++/include/decompile/Decompiler.h \
                        ../../mxslc++/include/reflection/reflect.h \
                        ../../mxslc++/include/reflection/Reflection.h \
                        ../../mxslc++/include/reflection/GlobalInfo.h
STRIP_FROM_PATH       = ../../mxslc++/include
STRIP_FROM_INC_PATH   = ../../mxslc++/include

# Document everything, not only declarations with a /// comment.
EXTRACT_ALL           = YES
HIDE_FRIEND_COMPOUNDS = YES
EXCLUDE_SYMBOLS       = std::*

# Primitive's constructors and members are generated by macros.
MACRO_EXPANSION       = YES

OUTPUT_DIRECTORY      = _build/doxygen
GENERATE_HTML         = NO
GENERATE_LATEX        = NO
GENERATE_XML          = YES

QUIET                 = YES
WARN_IF_UNDOCUMENTED  = NO
